# Supabase 配置示例，复制为 .env.local 并填入真实值

# Supabase 项目 URL（公开）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key（仅服务端使用，切勿暴露到前端）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 直连 Postgres 连接串（Drizzle 使用）
# 形如: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres